# VESTA AI keys. All optional. In Auto mode VESTA uses the first engine that works:
# Claude -> OpenRouter -> Groq -> Gemini -> Offline mode.

# 1. Claude (paid, best quality) - console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 2. OpenRouter (free) - openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 3. Groq (free) - console.groq.com
GROQ_API_KEY=
GROQ_MODEL=

# 4. Gemini (free) - aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude Code (local only, picked by hand in the model menu, no key).
# Uses your own logged-in Claude Code plan when the site runs on your computer.
# Model alias or name (default: opus). Effort: low, medium, high, xhigh or max (default: the CLI default).
VESTA_CLAUDE_CODE_MODEL=
VESTA_CLAUDE_CODE_EFFORT=
